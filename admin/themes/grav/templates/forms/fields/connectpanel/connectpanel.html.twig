{% extends "forms/field.html.twig" %}

{# Site-Check Connector — shared admin panel kit (Grav adapter).
   Design + behaviour live in sc-connector.css / sc-connector.js (this dir),
   kept in sync with .plugin/_shared/connector-ui/. The PHP injects both files
   inline via buildAdminConnectPanelState() so the panel stays self-contained. #}
{# The state comes from a plugin-registered Twig function (see
   SiteCheckAccessibilityPlugin::onTwigInitialized). Calling the plugin method
   directly on the object does not resolve through Grav's admin Twig. #}
{% set connect = sw_acc_admin_connect_state() %}
{# V1 hardcoded — must stay in sync with SiteCheckAccessibilityPlugin::WEBAPP_BASE_URL #}
{% set webappBaseUrlFallback = 'https://site-check.de' %}
{% set resolvedWebappBaseUrl = connect.webappBaseUrl|default('') ?: webappBaseUrlFallback %}
{% set scStatus = connect.status|default('not_connected') %}
{% set scState = scStatus == 'connected' ? 'connected' : (scStatus == 'error' ? 'interrupted' : 'disconnected') %}
{% set scBase = resolvedWebappBaseUrl|trim('/') %}

{% block field %}
  <div class="form-field">
    <div class="scc" data-sc-panel
      data-state="{{ scState }}"
      data-initial-status="{{ scStatus|e('html_attr') }}"
      data-initial-notice="{{ connect.lastNotice|default('')|e('html_attr') }}"
      data-initial-error="{{ connect.lastError|default('')|e('html_attr') }}"
      data-connect-endpoint="{{ connect.adminConnectEndpoint|default('')|e('html_attr') }}"
      data-disconnect-endpoint="{{ connect.adminDisconnectEndpoint|default('')|e('html_attr') }}"
      data-status-endpoint="{{ connect.adminStatusEndpoint|default('')|e('html_attr') }}"
      data-overlay-endpoint="{{ connect.adminOverlayEndpoint|default('')|e('html_attr') }}"
      data-webapp-status-endpoint="{{ connect.adminWebappStatusEndpoint|default('')|e('html_attr') }}"
      data-webapp-base-url="{{ resolvedWebappBaseUrl|e('html_attr') }}"
      data-csrf="{{ connect.csrfToken|default('')|e('html_attr') }}" data-csrf-header="{{ connect.csrfHeader|default('')|e('html_attr') }}"
    >
      <style>{{ connect.kitCss|raw }}</style>

      {# Brand bar #}
